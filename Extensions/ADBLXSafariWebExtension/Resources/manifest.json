{
    "manifest_version": 2,
    "name": "ADBLX Safari Web Extension",
    "description": "YouTube Ad Blocker and Video Shield for Safari.",
    "version": "1.0",
    "background": {
        "scripts": ["background.js"],
        "persistent": false
    },
    "content_scripts": [
        {
            "matches": [
                "*://m.youtube.com/*",
                "*://www.youtube.com/*"
            ],
            "js": ["content.js"],
            "run_at": "document_start",
            "all_frames": false
        }
    ],
    "permissions": [
        "storage",
        "*://*.youtube.com/*"
    ]
}
